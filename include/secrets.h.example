#pragma once

// Copy this file to include/secrets.h and fill in your own values.
// include/secrets.h is in .gitignore and must never be committed.

#define WIFI_SSID     "YOUR_2.4GHZ_WIFI_NAME"
#define WIFI_PASS     "YOUR_WIFI_PASSWORD"

// EMQX Serverless deployment: Deployment Overview -> MQTT Connection Information
#define MQTT_HOST     "YOUR_DEPLOYMENT.emqxsl.com"
#define MQTT_PORT     8883
// Created in EMQX: Access Control -> Client Authentication
#define MQTT_USER     "esp32"
#define MQTT_PASS     "YOUR_MQTT_PASSWORD"

// Download the trusted CA from your EMQX deployment via its authenticated
// console. Paste the complete PEM here; do not trust a certificate obtained
// only from an unverified connection. Keep MQTT_HOST as the broker DNS name.
// The placeholder deliberately fails TLS validation until replaced.
static const char MQTT_CA_CERT[] = R"PEM(
-----BEGIN CERTIFICATE-----
PASTE_YOUR_DEPLOYMENT_CA_CERTIFICATE_HERE
-----END CERTIFICATE-----
)PEM";
